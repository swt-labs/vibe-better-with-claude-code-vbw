{
  "modules": ["./panel.js"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -nc --arg root \"${CLAUDE_PROJECT_DIR:-$PWD}\" -f \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.jq\" - \"${CLAUDE_PROJECT_DIR:-$PWD}/.vbw/record.json\" \"${CLAUDE_PLUGIN_ROOT}/hooks/end.json\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c -f \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-ask.jq\" 2>/dev/null | { IFS= read -r in && bash \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-ask.sh\" \"$in\"; } 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "jq -nc --arg root \"${CLAUDE_PROJECT_DIR:-$PWD}\" -f \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-file.jq\" - \"${CLAUDE_PROJECT_DIR:-$PWD}/.vbw/record.json\" \"${CLAUDE_PLUGIN_ROOT}/hooks/end.json\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(jq -c -f \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-answer.jq\" 2>/dev/null); [ -z \"$out\" ] || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-answer.sh\" \"$out\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
