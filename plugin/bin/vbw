#!/usr/bin/env bash
# vbw: the VBW kernel. The only writer of .vbw/record.json.
# It is on PATH for Claude Code sessions and workflow agents (plugin bin/).
set -euo pipefail

VBW_LIB="$(cd "$(dirname "$0")/../lib" && pwd)"
VBW_PLUGIN="$(cd "$VBW_LIB/.." && pwd)"
export VBW_LIB VBW_PLUGIN

# shellcheck source=../lib/core.sh
. "$VBW_LIB/core.sh"
# shellcheck source=../lib/record.sh
. "$VBW_LIB/record.sh"
# shellcheck source=../lib/consent.sh
. "$VBW_LIB/consent.sh"
# shellcheck source=../lib/contract.sh
. "$VBW_LIB/contract.sh"

vbw_help() {
  cat <<'EOF'
usage: vbw <command> [args]

  init              create .vbw/ (spec and record) in this git repository
  spec check|sync   validate .vbw/spec.md; sync its requirements into the record
  spec add auto|human TEXT   append a requirement to the spec and sync
  status [--json]   where the project stands
  next [--json]     the next lifecycle step and whether it needs you
  show VIEW [ID]    roadmap | phase ID | req ID | contract | evidence
  approve           approve the contract and project commands (the user, via /vbw:approve)
  prove [--expect-red [CHECK...]]   run the approved checks and record the evidence
  todo add TEXT     add a backlog item
  commit PLAN MSG   commit a plan's declared files with provenance trailers
  version           print the plugin version
  help              this list
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  version) jq -r .version "$VBW_PLUGIN/.claude-plugin/plugin.json" ;;
  help|-h|--help) vbw_help ;;
  init|status|todo|commit|next|show|spec|approve|prove)
    # shellcheck source=/dev/null
    . "$VBW_LIB/cmd-$cmd.sh"
    "cmd_$cmd" "$@"
    ;;
  "") vbw_usage_error "no command given" ;;
  *) vbw_usage_error "unknown command: $cmd" ;;
esac
